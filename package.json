{
  "name": "radial-new-tab",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "check": "tsc --noEmit -p tsconfig.app.json --pretty false && eslint . --max-warnings 0 && pnpm format:check",
    "test": "vitest run && node --test scripts/publish-edge.test.mjs",
    "test:ui": "playwright test",
    "capture:store": "node scripts/capture-store-assets.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "package": "pnpm build && pnpm verify:release && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "lucide-react": "1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.2.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.12.0",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  }
}
